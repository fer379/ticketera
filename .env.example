# Clave secreta de Flask: generá una propia y no la compartas.
SECRET_KEY=

# Base local donde se guardan los tickets.
DATABASE_URL=sqlite:///ticketera.db

# Dirección y nombre del dominio de Active Directory.
AD_SERVER=ldap://192.168.56.101
AD_DOMAIN=IFTS.local
AD_BASE_DN=DC=IFTS,DC=local
AD_USE_SSL=false

# Cuenta técnica normal, sin privilegios, usada solo para consultar pwdLastSet.
# Dejá ambas variables vacías hasta crear la cuenta de lectura en AD.
AD_SESSION_READER_USERNAME=
AD_SESSION_READER_PASSWORD=
SESSION_PASSWORD_CHECK_INTERVAL_SECONDS=15

# Horario local permitido, formato de 24 horas HH:MM.
ACCESS_START=00:00
ACCESS_END=23:59

# Zona horaria usada para el horario y las fechas mostradas.
TIMEZONE=America/Argentina/Buenos_Aires
